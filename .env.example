# Copiar a .env.local en esta misma carpeta. No subir .env.local a Git.
# IMPORTANTE: la API todavia usa SQL Server (UseSqlServer).
# Esta conexion Neon se utilizara DESPUES de adaptar EF Core y el script SQL a PostgreSQL.
# ASP.NET Core no carga este archivo automaticamente: usar scripts/Iniciar-ConEnv.ps1.
# Formato: NOMBRE=valor. Se permiten comillas exteriores; no hay interpolacion de variables.

# === COMUN A LOS TRES SERVICIOS ===
# Local: Development. En Render: Production.
ASPNETCORE_ENVIRONMENT=Development
# Generar una clave aleatoria de al menos 32 bytes; usar la misma en los tres servicios.
Jwt__Clave=
Jwt__Emisor=VeterinariaApp.Api
Jwt__Audiencia=VeterinariaApp.Clientes

# === SOLO VeterinariaApp.Api ===
Jwt__MinutosExpiracion=60
# Neon > Connect: copiar host, database, role y password a formato Npgsql.
# No pegar aqui el comando psql ni la URL postgresql://.
# Si la contrasena contiene ;, encerrarla en comillas dobles dentro de la cadena.
ConnectionStrings__VeterinariaDB='Host=TU_HOST-pooler.REGION.aws.neon.tech;Port=5432;Database=neondb;Username=TU_USUARIO;Password=TU_PASSWORD;SSL Mode=VerifyFull;Channel Binding=Require;Pooling=true'
# Opcional, segun la licencia aplicable:
# AutoMapper__LicenseKey=

# === SOLO GatewayApi ===
# Valores locales. En Render reemplazar BaseUrl por la URL HTTPS del gateway.
GlobalConfiguration__BaseUrl=http://localhost:5143

# En Render, descomentar y completar las 21 variables siguientes.
# TU_API.onrender.com = hostname de VeterinariaApp.Api, SIN https:// ni barras.
# TU_CITAS.onrender.com = hostname de VeterinariaApp.Citas, SIN https:// ni barras.
# Los indices corresponden al orden actual de GatewayApi/ocelot.json.
# Routes__0__DownstreamScheme=https
# Routes__0__DownstreamHostAndPorts__0__Host=TU_API.onrender.com
# Routes__0__DownstreamHostAndPorts__0__Port=443
# Routes__1__DownstreamScheme=https
# Routes__1__DownstreamHostAndPorts__0__Host=TU_API.onrender.com
# Routes__1__DownstreamHostAndPorts__0__Port=443
# Routes__2__DownstreamScheme=https
# Routes__2__DownstreamHostAndPorts__0__Host=TU_API.onrender.com
# Routes__2__DownstreamHostAndPorts__0__Port=443
# Routes__3__DownstreamScheme=https
# Routes__3__DownstreamHostAndPorts__0__Host=TU_API.onrender.com
# Routes__3__DownstreamHostAndPorts__0__Port=443
# Routes__4__DownstreamScheme=https
# Routes__4__DownstreamHostAndPorts__0__Host=TU_API.onrender.com
# Routes__4__DownstreamHostAndPorts__0__Port=443
# Routes__5__DownstreamScheme=https
# Routes__5__DownstreamHostAndPorts__0__Host=TU_API.onrender.com
# Routes__5__DownstreamHostAndPorts__0__Port=443
# Routes__6__DownstreamScheme=https
# Routes__6__DownstreamHostAndPorts__0__Host=TU_CITAS.onrender.com
# Routes__6__DownstreamHostAndPorts__0__Port=443

# === DESPLIEGUE DOCKER / RENDER ===
# Configurar en cada servicio Render; no es necesario para ejecutar con el perfil http local.
# ASPNETCORE_HTTP_PORTS=8080
# Los argumentos de build son distintos de las variables de entorno:
# PROJECT=GatewayApi             (build del gateway)
# PROJECT=VeterinariaApp.Api     (build de la API)
# PROJECT=VeterinariaApp.Citas   (build de Citas)
#
# Alternativa a las 21 variables Routes__: ejecutar scripts/Configurar-RutasNube.ps1
# con las tres URL HTTPS reales y publicar ocelot.Production.json.
# No enviar ConnectionStrings__VeterinariaDB al gateway ni a Citas.
# En Render se ingresan las variables en Environment. No subir .env.local a la imagen.
