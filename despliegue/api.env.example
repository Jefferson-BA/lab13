# Render > veterinaria-api > Environment > Add from .env.
# Completar los dos valores privados antes de guardar.
PROJECT=VeterinariaApp.Api
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
BaseDatos__Proveedor=PostgreSQL
Jwt__Emisor=VeterinariaApp.Api
Jwt__Audiencia=VeterinariaApp.Clientes
Jwt__MinutosExpiracion=60
Jwt__Clave=REEMPLAZAR_POR_LA_MISMA_CLAVE_DE_CITAS
ConnectionStrings__VeterinariaDB=REEMPLAZAR_POR_LA_CADENA_NPGSQL_DE_ENV_LOCAL
