# Render > veterinaria-gateway > Environment > Add from .env.
# Reemplazar las URL por las reales que asigne Render, sin rutas al final.
PROJECT=GatewayApi
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
Jwt__Emisor=VeterinariaApp.Api
Jwt__Audiencia=VeterinariaApp.Clientes
Jwt__Clave=REEMPLAZAR_POR_LA_MISMA_CLAVE_DE_CITAS
GlobalConfiguration__BaseUrl=https://TU-GATEWAY.onrender.com
Servicios__ApiUrl=https://TU-API.onrender.com
Servicios__CitasUrl=https://veterinaria-citas.onrender.com
